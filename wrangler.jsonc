{
  // Deploys via Cloudflare Workers Builds (Git integration) on push to `main`.
  // The following settings live in the Cloudflare dashboard, not here:
  // Build configuration:
  //   Build:   pnpm exec opennextjs-cloudflare build
  //   Deploy:  pnpm exec opennextjs-cloudflare deploy
  //   Root:    /
  // Branch control:
  //   Production branch: main
  //   Non-production builds: disabled
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "compatibility_date": "2026-07-06",
  // nodejs_compat lets the Next.js server bundle use Node built-ins on Workers.
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "name": "credit-heatmap",
  "ratelimits": [
    {
      "name": "ORCID_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    // log 10% of requests
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      // ORCID identifiers are submitted to /api/orcid and must not land in request logs.
      "invocation_logs": false
    }
  },
  // Bound to a Custom Domain
  "routes": [
    {
      "pattern": "credit.duinlab.nl",
      "custom_domain": true
    }
  ],
  "workers_dev": false
}
